{
  "name": "lichouz",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:rls": "vitest run tests/rls",
    "recettes": "node --experimental-strip-types --no-warnings scripts/recettes/generer.ts",
    "prod:sql": "node --experimental-strip-types --no-warnings scripts/prod/assembler.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0"
  },
  "engines": {
    "node": ">=22.12"
  }
